[Unit]
Description=Claim Expiry Timer (every 1 minute)
Documentation=https://github.com/DanishHaji/Personal-AI-Employee-Hackathon-0
Requires=claim-expiry.service

[Timer]
# Run 30 seconds after boot
OnBootSec=30s

# Run every 1 minute after the last activation
OnUnitActiveSec=1min

# Allow up to 5 seconds of timing imprecision
AccuracySec=5s

# If the system was off when the timer should have triggered,
# trigger it immediately on boot
Persistent=true

[Install]
WantedBy=timers.target
