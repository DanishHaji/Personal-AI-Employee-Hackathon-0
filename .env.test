# Test Mode Configuration (No Gmail Required)
# Use this for testing without Gmail API verification

# Vault Path
VAULT_PATH=/mnt/e/Hackathon 0 AI Employee/Personal AI Employee Hackathon 0/test-vault

# Enable Test Mode (Bypasses Gmail)
TEST_MODE=true
SKIP_GMAIL=true
USE_MOCK_EMAIL=true

# Mock Gmail Settings
MOCK_EMAIL_INTERVAL=30  # Check every 30 seconds for new files

# Optional: If you want to test other features
USE_MOCK_CALENDAR=true
USE_MOCK_ZOOM=true
USE_MOCK_WHATSAPP=true

# Features to Enable (Silver/Gold)
ENABLE_SCHEDULER=true
ENABLE_SOCIAL_MEDIA=false
ENABLE_WHATSAPP=false
ENABLE_CALENDAR=false
ENABLE_MEETINGS=false
ENABLE_ANALYTICS=true
ENABLE_EXPENSES=true

# Encryption (for Gold Tier CRM)
ENCRYPTION_KEY_PATH=./encryption_key.key

# Rate Limiting
RATE_LIMIT_STATE_FILE=./Logs/rate_limit_state.json

# Logging
LOG_LEVEL=INFO
