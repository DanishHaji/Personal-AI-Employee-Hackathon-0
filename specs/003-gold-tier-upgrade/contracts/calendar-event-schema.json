{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-employee.local/schemas/calendar-event.json",
  "title": "CalendarEvent",
  "description": "Google Calendar event with conflict tracking",
  "type": "object",
  "required": [
    "event_id",
    "title",
    "start_time",
    "end_time",
    "priority",
    "created_by",
    "created_at",
    "last_modified",
    "status"
  ],
  "properties": {
    "ENCRYPTED_FIELDS": {
      "type": "array",
      "description": "List of encrypted field names (from BaseModel)",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "description": "Entity type identifier (from BaseModel)",
      "enum": ["calendar_event"]
    },
    "event_id": {
      "type": "string",
      "pattern": "^CAL_[a-zA-Z0-9_]+$",
      "description": "Google Calendar event ID"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Event summary/title"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Event start time (ISO 8601 with timezone)"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Event end time (ISO 8601 with timezone)"
    },
    "attendees": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "response_status": {
            "type": "string",
            "enum": ["accepted", "declined", "tentative", "needsAction"]
          }
        }
      },
      "description": "List of attendees"
    },
    "location": {
      "type": ["string", "null"],
      "description": "Physical location"
    },
    "video_link": {
      "type": ["string", "null"],
      "format": "uri",
      "description": "Video conference URL"
    },
    "agenda": {
      "type": ["string", "null"],
      "description": "Meeting agenda/description"
    },
    "recurring_pattern": {
      "type": ["string", "null"],
      "description": "RRULE format for recurring events (RFC 5545)"
    },
    "recurrence_id": {
      "type": ["string", "null"],
      "description": "Parent event ID for recurring series"
    },
    "priority": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "default": "medium",
      "description": "Event priority"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of conflicting event IDs"
    },
    "created_by": {
      "type": "string",
      "enum": ["ai", "user"],
      "description": "Creator of the event"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "last_modified": {
      "type": "string",
      "format": "date-time",
      "description": "Last modification timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["confirmed", "tentative", "cancelled"],
      "description": "Event status"
    }
  },
  "examples": [
    {
      "event_id": "CAL_abc123xyz",
      "title": "Q2 Planning Meeting",
      "start_time": "2026-03-15T14:00:00-07:00",
      "end_time": "2026-03-15T15:00:00-07:00",
      "attendees": [
        {
          "email": "john@example.com",
          "name": "John Smith",
          "response_status": "accepted"
        }
      ],
      "location": "Conference Room A",
      "video_link": "https://zoom.us/j/123456789",
      "agenda": "Discuss Q2 objectives",
      "recurring_pattern": null,
      "recurrence_id": null,
      "priority": "high",
      "conflicts": [],
      "created_by": "ai",
      "created_at": "2026-02-27T10:00:00Z",
      "last_modified": "2026-02-27T10:00:00Z",
      "status": "confirmed"
    }
  ]
}
