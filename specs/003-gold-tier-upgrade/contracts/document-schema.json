{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-employee.local/schemas/document.json",
  "title": "Document",
  "description": "Generated document with version tracking and metadata",
  "type": "object",
  "required": [
    "document_id",
    "title",
    "document_type",
    "template_used",
    "created_at",
    "created_by",
    "version",
    "status"
  ],
  "properties": {
    "ENCRYPTED_FIELDS": {
      "type": "array",
      "description": "List of encrypted field names (from BaseModel)",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "description": "Entity type identifier (from BaseModel)",
      "enum": ["document"]
    },
    "document_id": {
      "type": "string",
      "pattern": "^DOC_[a-zA-Z0-9_]+$",
      "description": "Unique document identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Document title"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "meeting_notes",
        "status_report",
        "monthly_summary",
        "proposal",
        "memo",
        "analysis",
        "other"
      ],
      "description": "Type of document"
    },
    "template_used": {
      "type": "string",
      "description": "Template filename used for generation"
    },
    "folder": {
      "type": ["string", "null"],
      "description": "Folder path in vault (e.g., Documents/Status Reports)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document tags for organization"
    },
    "generation_source": {
      "type": ["string", "null"],
      "description": "Source of data used for generation (e.g., audit_logs, meeting_notes)"
    },
    "generation_params": {
      "type": ["object", "null"],
      "description": "Parameters used during generation",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp (ISO 8601)"
    },
    "created_by": {
      "type": "string",
      "enum": ["ai", "user"],
      "description": "Creator of the document"
    },
    "last_modified": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Last modification timestamp"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Document version number"
    },
    "previous_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "timestamp", "document_id"],
        "properties": {
          "version": {
            "type": "integer"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "document_id": {
            "type": "string"
          }
        }
      },
      "description": "History of previous versions"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "final", "archived"],
      "description": "Document status"
    },
    "encryption_status": {
      "type": "boolean",
      "description": "Whether sensitive fields are encrypted"
    }
  },
  "examples": [
    {
      "document_id": "DOC_weekly_status_2026_03_01",
      "title": "Weekly Status Report - Week of March 1, 2026",
      "document_type": "status_report",
      "template_used": "weekly-status.md.j2",
      "folder": "Documents/Status Reports",
      "tags": ["weekly", "status", "2026-Q1"],
      "generation_source": "audit_logs",
      "generation_params": {
        "start_date": "2026-02-24",
        "end_date": "2026-03-01"
      },
      "created_at": "2026-03-01T17:00:00Z",
      "created_by": "ai",
      "last_modified": "2026-03-01T17:00:00Z",
      "version": 1,
      "previous_versions": [],
      "status": "final",
      "encryption_status": false
    }
  ]
}
