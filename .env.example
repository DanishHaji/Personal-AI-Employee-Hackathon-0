# Gmail Integration (OPTIONAL - Can be added later)
# Set GMAIL_ENABLED=false to skip Gmail if credentials not available yet
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Vault location (absolute path to your Obsidian vault)
VAULT_PATH=/path/to/your/vault

# Development mode (set to false for production)
DEV_MODE=true

# Gmail polling interval in seconds (default: 120 = 2 minutes)
CHECK_INTERVAL=120

# Urgent keywords for email priority detection (comma-separated)
URGENT_KEYWORDS=urgent,asap,invoice,payment,help

# ========================================
# SILVER TIER - MCP Server Configurations
# ========================================

# Development mode for Silver Tier execution (set to true to prevent real API calls)
DRY_RUN=true

# MCP Server URLs for external integrations
# Gmail MCP Server (for sending emails)
GMAIL_MCP_URL=http://localhost:3001/gmail

# LinkedIn MCP Server (for posting content)
LINKEDIN_MCP_URL=http://localhost:3002/linkedin

# Facebook MCP Server (for page/group posts)
FACEBOOK_MCP_URL=http://localhost:3003/facebook

# Twitter/X MCP Server (for tweets and threads)
TWITTER_MCP_URL=http://localhost:3004/twitter

# WhatsApp Business MCP Server (for message monitoring)
WHATSAPP_MCP_URL=http://localhost:3005/whatsapp

# Rate Limiting State File
RATE_LIMIT_STATE_FILE=./Logs/rate_limit_state.json

# Execution Polling Interval (seconds) - How often executor checks /Approved/ folder
EXECUTOR_POLL_INTERVAL=5

# WhatsApp Polling Interval (seconds) - How often to check for new WhatsApp messages
WHATSAPP_POLL_INTERVAL=60

# Scheduled Tasks Check Interval (seconds) - How often scheduler checks for due tasks
SCHEDULER_CHECK_INTERVAL=30

# ========================================
# GOLD TIER - Advanced AI Features
# ========================================

# ----------------
# Calendar Management (US2)
# ----------------
# Google Calendar API Credentials
GOOGLE_CALENDAR_CREDENTIALS_PATH=./google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=./google_calendar_token.json
GOOGLE_CALENDAR_ENABLED=false

# Calendar sync interval (seconds) - How often to sync with Google Calendar
CALENDAR_SYNC_INTERVAL=3600

# ----------------
# Meeting Transcription (US6)
# ----------------
# OpenAI API Key for Whisper transcription
OPENAI_API_KEY=your-openai-api-key-here

# Zoom SDK Credentials
ZOOM_API_KEY=your-zoom-api-key-here
ZOOM_API_SECRET=your-zoom-api-secret-here

# Local Whisper fallback (set to true to use local Whisper model if API unavailable)
USE_LOCAL_WHISPER=false

# ----------------
# Expense Tracking (US8)
# ----------------
# Google Vision API for OCR fallback (optional - falls back to EasyOCR if not set)
GOOGLE_APPLICATION_CREDENTIALS=./google_vision_credentials.json
VISION_API_ENABLED=false

# OCR confidence threshold for Vision API fallback (0.0-1.0)
OCR_VISION_THRESHOLD=0.75

# Default currency for expenses
DEFAULT_CURRENCY=USD

# ----------------
# Analytics & Insights (US4)
# ----------------
# Analytics generation schedule (cron format: "0 17 * * 5" = Friday 5pm)
ANALYTICS_SCHEDULE=0 17 * * 5

# Minimum days of audit log history required for analytics
ANALYTICS_MIN_DAYS=30

# ----------------
# Proactive Suggestions (US5)
# ----------------
# Suggestion engine check interval (seconds)
SUGGESTION_CHECK_INTERVAL=3600

# Maximum suggestions per category per day
MAX_SUGGESTIONS_PER_CATEGORY=3

# ----------------
# Trust Framework (US1)
# ----------------
# Trust rule effectiveness threshold (auto-disable below this score)
TRUST_EFFECTIVENESS_THRESHOLD=0.80

# Trust evaluation performance target (milliseconds)
TRUST_EVAL_MAX_TIME_MS=10

# ----------------
# Encryption & Security
# ----------------
# Keyring backend for encryption key storage (system, file, memory)
KEYRING_BACKEND=system

# Service name for keyring storage
KEYRING_SERVICE_NAME=ai-employee-gold

# ----------------
# Performance & Rate Limiting
# ----------------
# Google Calendar API rate limit (queries per day)
GOOGLE_CALENDAR_DAILY_LIMIT=1000000

# Whisper API rate limit (requests per minute)
WHISPER_API_RATE_LIMIT=50

# Performance monitoring enabled
PERFORMANCE_MONITORING=true

# ----------------
# GDPR & Compliance
# ----------------
# Enable data export functionality
DATA_EXPORT_ENABLED=true

# Data retention period (days, 0 = keep forever)
DATA_RETENTION_DAYS=365

# ----------------
# Background Processes
# ----------------
# Enable background watchers and engines
ANALYTICS_ENGINE_ENABLED=true
SUGGESTION_ENGINE_ENABLED=true
CALENDAR_WATCHER_ENABLED=true
CRM_WATCHER_ENABLED=true

# ----------------
# Feature Flags
# ----------------
# Enable specific Gold Tier features
TRUST_FRAMEWORK_ENABLED=true
CALENDAR_MANAGEMENT_ENABLED=false
DOCUMENT_GENERATION_ENABLED=true
ANALYTICS_INSIGHTS_ENABLED=true
PROACTIVE_SUGGESTIONS_ENABLED=true
MEETING_ATTENDANCE_ENABLED=false
CRM_INTEGRATION_ENABLED=false
EXPENSE_TRACKING_ENABLED=false
