# Gmail Integration (OPTIONAL - Can be added later)
# Set GMAIL_ENABLED=false to skip Gmail if credentials not available yet
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Vault location (absolute path to your Obsidian vault)
VAULT_PATH=/path/to/your/vault

# Development mode (set to false for production)
DEV_MODE=true

# Gmail polling interval in seconds (default: 120 = 2 minutes)
CHECK_INTERVAL=120

# Urgent keywords for email priority detection (comma-separated)
URGENT_KEYWORDS=urgent,asap,invoice,payment,help
